    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CentralBillingService.Application\CentralBillingService.Application.csproj" />
    <ProjectReference Include="..\CentralBillingService.Infrastructure\CentralBillingService.Infrastructure.csproj" />
