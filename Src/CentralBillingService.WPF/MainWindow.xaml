<Window x:Class="CentralBillingService.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:CentralBillingService.WPF.ViewModels"
        xmlns:views="clr-namespace:CentralBillingService.WPF.Views"
        Title="Central Billing Admin"
        Icon="Resources/app.ico"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{StaticResource ContentBackground}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <!-- DataTemplates para navegación -->
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
            <views:InvoicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceDetailViewModel}">
            <views:InvoiceDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateInvoiceViewModel}">
            <views:CreateInvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RectifyInvoiceViewModel}">
            <views:RectifyInvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerifyInvoiceViewModel}">
            <views:VerifyInvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MasterDataViewModel}">
            <views:MasterDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingSourcesViewModel}">
            <views:BillingSourcesView />
        </DataTemplate>

        <!-- Sidebar item style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground"  Value="{StaticResource SidebarText}" />
            <Setter Property="Background"  Value="Transparent" />
            <Setter Property="Cursor"      Value="Hand" />
            <Setter Property="Padding"     Value="16,12" />
            <Setter Property="Margin"      Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SidebarSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,28,20,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="ReceiptText"
                                                 Foreground="#6EE7B7"
                                                 Width="28" Height="28"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="CBS Admin"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Central Billing Service"
                               Foreground="#34D399"
                               FontSize="11" />
                </StackPanel>

                <!-- Section label -->
                <TextBlock Grid.Row="1"
                           Text="FUENTES DE FACTURACIÓN"
                           Foreground="#4B5563"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="24,0,20,8" />

                <!-- Billing sources list -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding BillingSources}"
                         SelectedItem="{Binding SelectedBillingSource}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StorefrontOutline"
                                                         Foreground="#6EE7B7"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#34D399"
                                               FontSize="10"
                                               Opacity="0.7" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Datos Maestros section -->
                <Border Grid.Row="3" BorderBrush="#065F46" BorderThickness="0,1,0,0"
                        Padding="8,10">
                    <StackPanel>
                        <TextBlock Text="HERRAMIENTAS"
                                   Foreground="#4B5563"
                                   FontSize="10" FontWeight="SemiBold"
                                   Margin="16,0,0,6" />

                        <!-- Fuentes de Facturación -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="16,10"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenBillingSourcesCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="MouseOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                Value="{StaticResource SidebarHover}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState Name="Normal" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TuneVariant"
                                                         Foreground="#6EE7B7"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0" />
                                <TextBlock Text="Fuentes de Facturación"
                                           Foreground="{StaticResource SidebarText}"
                                           FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Datos Maestros -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="16,10"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenMasterDataCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="MouseOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                Value="{StaticResource SidebarHover}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState Name="Normal" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseOutline"
                                                         Foreground="#6EE7B7"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0" />
                                <TextBlock Text="Datos Maestros"
                                           Foreground="{StaticResource SidebarText}"
                                           FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             CONTENT AREA
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <!-- Main content switches by ViewModel type -->
            <ContentControl Content="{Binding CurrentView}"
                            Focusable="False" />

            <!-- Empty state when no billing source selected -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding EmptyStateVisible}">
                <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                         Width="72" Height="72"
                                         Foreground="#CBD5E1"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="Selecciona una fuente de facturación"
                           Foreground="#94A3B8"
                           FontSize="18"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Elige una fuente del panel izquierdo para ver sus facturas."
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
