<Window x:Class="CentralBillingService.WPF.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="Resources/app.ico">

    <Border Background="#064E3B" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0"
                   Source="pack://application:,,,/Resources/app.ico"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Nombre de la aplicación -->
            <TextBlock Grid.Row="1"
                       Text="Central Billing Service"
                       Foreground="#D1FAE5"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <!-- Panel de carga (visible por defecto) -->
            <StackPanel x:Name="LoadingPanel"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="52" Height="52"
                             Foreground="#10B981"
                             Value="0"
                             HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Cargando..."
                           Foreground="#A7F3D0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Panel de error (oculto por defecto) -->
            <StackPanel x:Name="ErrorPanel"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                         Width="52" Height="52"
                                         Foreground="#FCA5A5"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="No se ha podido iniciar la aplicación"
                           Foreground="#FCA5A5"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,12,0,8"/>
                <TextBlock x:Name="ErrorText"
                           Foreground="#FEE2E2"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="500"/>
            </StackPanel>

            <!-- Botón Salir (solo visible en error) -->
            <Button x:Name="ExitButton"
                    Grid.Row="3"
                    Content="Salir"
                    Visibility="Collapsed"
                    Click="ExitButton_Click"
                    Width="120"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Background="#EF4444"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </Grid>
    </Border>
</Window>
