<UserControl x:Class="CentralBillingService.WPF.Views.InvoicePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CentralBillingService.WPF.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource ContentBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding GoBackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0" />
                        <TextBlock Text="Volver" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentOutline"
                                             Foreground="#64748B" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding InvoiceNumber}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                    <Border Background="#F1F5F9" CornerRadius="6"
                            Padding="8,2" Margin="10,0,0,0">
                        <TextBlock Text="{Binding BillingSourceName}"
                                   FontSize="11" Foreground="#64748B" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: WebView2 behind state overlays -->
        <Grid Grid.Row="1">

            <!-- PDF viewer — always in visual tree so WebView2 can initialize -->
            <wv2:WebView2 x:Name="PdfViewer" />

            <!-- Loading overlay — covers WebView2 while generating PDF -->
            <Grid Background="{StaticResource ContentBackground}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True" Width="48" Height="48" />
                    <TextBlock Text="Generando factura..." Margin="0,12,0,0"
                               Foreground="#64748B" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Error overlay -->
            <Grid Background="{StaticResource ContentBackground}"
                  Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="48" Height="48"
                                             Foreground="#EF4444" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                               Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="400"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
