<UserControl x:Class="CentralBillingService.WPF.Views.VerifyInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CentralBillingService.WPF.Converters"
             Background="{StaticResource ContentBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="HasValue" />
        <conv:NullToVisibilityConverter x:Key="IsNull" InvertWhenNull="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding GoBackCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" />
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Verificación de Integridad" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <TextBlock Foreground="#64748B" FontSize="12">
                        <Run Text="Factura " />
                        <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding BillingSource.DisplayName}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="56" Height="56" />
                <TextBlock Text="Verificando integridad…" Foreground="#64748B"
                           FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error loading -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="500"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValue}}">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="64" Height="64"
                                         Foreground="#EF4444" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                           FontSize="14" Margin="0,16,0,20"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center">
                    Reintentar
                </Button>
            </StackPanel>

            <!-- Result -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520" Margin="24"
                        Visibility="{Binding Result, Converter={StaticResource HasValue}}">

                <!-- Main status icon -->
                <Border Width="100" Height="100" CornerRadius="50"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result.IsValid}" Value="True">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result.IsValid}" Value="False">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <materialDesign:PackIcon Width="52" Height="52"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.IsValid}" Value="True">
                                        <Setter Property="Kind"       Value="ShieldCheckOutline" />
                                        <Setter Property="Foreground" Value="#10B981" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result.IsValid}" Value="False">
                                        <Setter Property="Kind"       Value="ShieldAlertOutline" />
                                        <Setter Property="Foreground" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Border>

                <!-- Status text -->
                <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result.IsValid}" Value="True">
                                    <Setter Property="Text"       Value="Factura íntegra" />
                                    <Setter Property="Foreground" Value="#065F46" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result.IsValid}" Value="False">
                                    <Setter Property="Text"       Value="Posible manipulación detectada" />
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding Result.Message}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="#475569"
                           FontSize="13" Margin="0,0,0,28" />

                <!-- Detail card -->
                <materialDesign:Card Padding="20" UniformCornerRadius="10"
                                     materialDesign:ElevationAssist.Elevation="Dp1"
                                     Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Número" Foreground="#94A3B8" FontSize="12" />
                            <TextBlock Text="{Binding Result.InvoiceNumber}"
                                       HorizontalAlignment="Right" FontWeight="Medium" FontSize="13" />
                        </Grid>
                        <Separator Margin="0,0,0,12" />
                        <Grid>
                            <TextBlock Text="Hash SHA-256" Foreground="#94A3B8" FontSize="12" />
                        </Grid>
                        <TextBox Text="{Binding Result.Hash, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="#475569"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,6,0" />
                        <TextBlock Text="Verificar de nuevo" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
