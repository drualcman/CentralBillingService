<UserControl x:Class="CentralBillingService.WPF.Views.BillingSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CentralBillingService.WPF.Converters"
             Background="{StaticResource ContentBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="HasValue" />
        <BooleanToVisibilityConverter  x:Key="NativeBoolToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin"     Value="0,8,0,2" />
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin"  Value="0,0,4,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fuentes de Facturación"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text="Gestiona las empresas emisoras almacenadas en la configuración"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Aviso reinicio -->
            <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B"
                    BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Foreground="#B45309" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Foreground="#92400E" FontSize="12" VerticalAlignment="Center"
                               Text="Los cambios en el identificador y el secreto requieren reiniciar la aplicación para surtir efecto en la firma de facturas." />
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="1" Margin="16,12,16,4"
                                  materialDesign:ElevationAssist.Elevation="Dp1"
                                  UniformCornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Background="White" BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ActionBtn}"
                                    Command="{Binding NewSourceCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Nueva fuente" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionBtn}"
                                    Command="{Binding EditSourceCommand}"
                                    IsEnabled="{Binding SelectedSource, Converter={StaticResource HasValue}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Editar" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionBtn}"
                                    Command="{Binding DeleteSourceCommand}"
                                    IsEnabled="{Binding SelectedSource, Converter={StaticResource HasValue}}"
                                    Foreground="#EF4444">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Eliminar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="44"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identificador"    Binding="{Binding Key}"          Width="160" />
                            <DataGridTextColumn Header="Nombre comercial" Binding="{Binding TradeName}"    Width="*" />
                            <DataGridTextColumn Header="Nombre fiscal"    Binding="{Binding LegalName}"    Width="*" />
                            <DataGridTextColumn Header="NIF"              Binding="{Binding TaxIdValue}"   Width="130" />
                            <DataGridTextColumn Header="Email"            Binding="{Binding Email}"        Width="200" />
                            <DataGridTextColumn Header="Ciudad"           Binding="{Binding City}"         Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Edit form -->
            <materialDesign:Card Grid.Row="2" Margin="16,0,16,12"
                                  materialDesign:ElevationAssist.Elevation="Dp2"
                                  UniformCornerRadius="10" Padding="20"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="DATOS DE LA FUENTE DE FACTURACIÓN"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="0,0,0,4" />

                    <!-- Error box -->
                    <Border Background="#FEF2F2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding EditError, Converter={StaticResource HasValue}}">
                        <TextBlock Text="{Binding EditError}" Foreground="#DC2626"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Row 1: Key + Secret + (disabled note) -->
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Identificador * (ej: web-tienda)" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditKey, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsNewRecord}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Secreto (token) *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditSecret, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="URL web (opcional)" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditWebsite, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Row 2: Fiscal data -->
                    <UniformGrid Columns="4" Margin="0,4,0,4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre fiscal *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditLegalName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre comercial" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditTradeName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NIF / VAT *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditTaxIdValue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="País NIF (ES, GB…)" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditTaxIdCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Row 3: Contact + address -->
                    <UniformGrid Columns="5" Margin="0,4,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Email *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Teléfono" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dirección *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditAddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ciudad *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Código postal *" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditPostalCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Form actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding CancelEditCommand}"
                                Margin="0,0,8,0">
                            Cancelar
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveSourceCommand}"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            Guardar fuente
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
