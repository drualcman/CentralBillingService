<UserControl x:Class="CentralBillingService.WPF.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CentralBillingService.WPF.Converters"
             Background="{StaticResource ContentBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="HasValue" />

        <Style x:Key="TabActionButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin"  Value="0,0,4,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin"     Value="0,8,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Datos Maestros"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text="Clientes, series y productos reutilizables al crear facturas"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">

            <!-- ══════════════════════════════════════════
                 TAB: CLIENTES
                 ══════════════════════════════════════════ -->
            <TabItem Header="Clientes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- List -->
                    <materialDesign:Card Grid.Row="0" Margin="16,12,16,4"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         UniformCornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding NewClientCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Nuevo" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding EditClientCommand}"
                                            IsEnabled="{Binding SelectedClient, Converter={StaticResource HasValue}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Editar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding DeleteClientCommand}"
                                            IsEnabled="{Binding SelectedClient, Converter={StaticResource HasValue}}"
                                            Foreground="#EF4444">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Eliminar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Clients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre fiscal"    Binding="{Binding LegalName}"   Width="*" />
                                    <DataGridTextColumn Header="Nombre comercial" Binding="{Binding TradeName}"   Width="160" />
                                    <DataGridTextColumn Header="NIF"              Binding="{Binding TaxId}"       Width="120" />
                                    <DataGridTextColumn Header="País NIF"         Binding="{Binding TaxIdCountry}" Width="70" />
                                    <DataGridTextColumn Header="Email"            Binding="{Binding Email}"       Width="200" />
                                    <DataGridTextColumn Header="Ciudad"           Binding="{Binding City}"        Width="130" />
                                    <DataGridTextColumn Header="ID externo"       Binding="{Binding ExternalId}"  Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Edit form -->
                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,12"
                                         materialDesign:ElevationAssist.Elevation="Dp2"
                                         UniformCornerRadius="10" Padding="20"
                                         Visibility="{Binding IsEditingClient, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="DATOS DEL CLIENTE"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,4" />

                            <Border Background="#FEF2F2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding ClientEditError, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding ClientEditError}" Foreground="#DC2626"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,4">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre fiscal *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientLegalName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre comercial" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientTradeName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="NIF / VAT *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientTaxId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="País NIF (ES, GB…)" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientTaxIdCountry, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,4">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Email *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dirección *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ciudad *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientCity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Código postal *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditClientPostalCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ID externo" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             ToolTip="Identificador del cliente en tu sistema (CRM, ERP…)"
                                             Text="{Binding EditClientExternalId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Form actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding CancelClientEditCommand}"
                                        Margin="0,0,8,0">
                                    Cancelar
                                </Button>
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding SaveClientCommand}"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    Guardar cliente
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB: SERIES
                 ══════════════════════════════════════════ -->
            <TabItem Header="Series">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="16,12,16,4"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         UniformCornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding NewSeriesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Nueva" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding EditSeriesCommand}"
                                            IsEnabled="{Binding SelectedSeries, Converter={StaticResource HasValue}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Editar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding DeleteSeriesCommand}"
                                            IsEnabled="{Binding SelectedSeries, Converter={StaticResource HasValue}}"
                                            Foreground="#EF4444">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Eliminar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Series}"
                                      SelectedItem="{Binding SelectedSeries}"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código"      Binding="{Binding Code}"        Width="140" />
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Edit form -->
                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,12"
                                         materialDesign:ElevationAssist.Elevation="Dp2"
                                         UniformCornerRadius="10" Padding="20"
                                         Visibility="{Binding IsEditingSeries, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DATOS DE LA SERIE"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,12" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Código *  (p.ej. FAC, R)" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditSeriesCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditSeriesDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelSeriesEditCommand}"
                                            Margin="0,0,8,0">
                                        Cancelar
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveSeriesCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        Guardar
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB: PRODUCTOS / CONCEPTOS
                 ══════════════════════════════════════════ -->
            <TabItem Header="Productos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="16,12,16,4"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         UniformCornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding NewProductCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Nuevo" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding EditProductCommand}"
                                            IsEnabled="{Binding SelectedProduct, Converter={StaticResource HasValue}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Editar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding DeleteProductCommand}"
                                            IsEnabled="{Binding SelectedProduct, Converter={StaticResource HasValue}}"
                                            Foreground="#EF4444">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Eliminar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código"       Binding="{Binding Code}"               Width="120" />
                                    <DataGridTextColumn Header="Descripción"  Binding="{Binding Description}"        Width="*" />
                                    <DataGridTextColumn Header="Precio unit." Binding="{Binding DefaultUnitPrice, StringFormat='{}{0:F2}'}" Width="120" />
                                    <DataGridTextColumn Header="IVA %"        Binding="{Binding DefaultTaxRate, StringFormat='{}{0}%'}" Width="80" />
                                    <DataGridTextColumn Header="Moneda"       Binding="{Binding DefaultCurrencyCode}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Edit form -->
                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,12"
                                         materialDesign:ElevationAssist.Elevation="Dp2"
                                         UniformCornerRadius="10" Padding="20"
                                         Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DATOS DEL PRODUCTO / CONCEPTO"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,12" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Código" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditProductCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditProductDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Precio unit." />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditProductUnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="IVA %" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditProductTaxRate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Moneda" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EditProductCurrencyCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelProductEditCommand}"
                                            Margin="0,0,8,0">
                                        Cancelar
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveProductCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        Guardar
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB: NOTAS / PLANTILLAS
                 ══════════════════════════════════════════ -->
            <TabItem Header="Notas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="16,12,16,4"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         UniformCornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding NewNoteCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Nueva" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding EditNoteCommand}"
                                            IsEnabled="{Binding SelectedNote, Converter={StaticResource HasValue}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Editar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding DeleteNoteCommand}"
                                            IsEnabled="{Binding SelectedNote, Converter={StaticResource HasValue}}"
                                            Foreground="#EF4444">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Eliminar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Notes}"
                                      SelectedItem="{Binding SelectedNote}"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre"    Binding="{Binding Name}"    Width="220" />
                                    <DataGridTextColumn Header="Contenido" Binding="{Binding Content}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Edit form -->
                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,12"
                                         materialDesign:ElevationAssist.Elevation="Dp2"
                                         UniformCornerRadius="10" Padding="20"
                                         Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="DATOS DE LA NOTA / PLANTILLA"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,4" />

                            <Border Background="#FEF2F2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding NoteEditError, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding NoteEditError}" Foreground="#DC2626"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre *  (p.ej. Datos Bancarios, Aviso Legal…)" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditNoteName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Contenido" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding EditNoteContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinLines="4" MaxLines="10"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding CancelNoteEditCommand}"
                                        Margin="0,0,8,0">
                                    Cancelar
                                </Button>
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding SaveNoteCommand}"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    Guardar nota
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB: SECUENCIAS
                 ══════════════════════════════════════════ -->
            <TabItem Header="Secuencias">
                <TabItem.Resources>
                    <conv:BoolToVisibilityConverter x:Key="SeqBoolToVis" />
                    <conv:BoolToVisibilityConverter x:Key="SeqInvBoolToVis" Invert="True" />
                    <conv:NullToVisibilityConverter x:Key="SeqHasValue" />
                </TabItem.Resources>

                <Grid DataContext="{Binding SequenceAdmin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="16,12,16,4"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         UniformCornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding LoadCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Cargar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TabActionButton}"
                                            Command="{Binding OpenInitCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="Inicializar serie" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Loading indicator -->
                                    <ProgressBar IsIndeterminate="True"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Width="20" Height="20" Margin="8,0,0,0"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource SeqBoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Sequences}"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BillingSource" Binding="{Binding BillingSource}" Width="180" />
                                    <DataGridTextColumn Header="Serie"         Binding="{Binding Serie}"         Width="120" />
                                    <DataGridTextColumn Header="Año"           Binding="{Binding Year}"          Width="70" />
                                    <DataGridTextColumn Header="Último nº"     Binding="{Binding LastNumber}"    Width="90" />
                                    <DataGridCheckBoxColumn Header="¿Con facturas?" Binding="{Binding HasInvoices}" Width="110" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.DeleteSequenceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#EF4444" Padding="4">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Init form -->
                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,12"
                                         materialDesign:ElevationAssist.Elevation="Dp2"
                                         UniformCornerRadius="10" Padding="20"
                                         Visibility="{Binding IsInitializing, Converter={StaticResource SeqBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="INICIALIZAR / AJUSTAR SECUENCIA"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,4" />

                            <TextBlock Text="Crea la secuencia en la base de datos o ajusta el número de inicio si aún no hay facturas emitidas."
                                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap" />

                            <!-- Error / success banners -->
                            <Border Background="#FEF2F2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource SeqHasValue}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding SuccessMessage, Converter={StaticResource SeqHasValue}}">
                                <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="BillingSource *" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding BillingSources}"
                                              SelectedItem="{Binding InitBillingSource}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Serie *  (p.ej. FAC, R)" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding InitSerie, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Año *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding InitYear, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Empieza en nº *" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding InitStartAt, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelInitCommand}"
                                            Margin="0,0,8,0">
                                        Cancelar
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveInitCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        Guardar
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Success banner when form is not open -->
                    <Border Grid.Row="1" Margin="16,0,16,12" Background="#F0FDF4"
                            CornerRadius="8" Padding="16,10"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource SeqHasValue}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A"
                                   FontSize="12" TextWrapping="Wrap"
                                   Visibility="{Binding IsInitializing, Converter={StaticResource SeqInvBoolToVis}}" />
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
