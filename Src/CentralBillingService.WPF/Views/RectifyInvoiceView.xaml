<UserControl x:Class="CentralBillingService.WPF.Views.RectifyInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CentralBillingService.WPF.Converters"
             xmlns:vm="clr-namespace:CentralBillingService.WPF.ViewModels"
             xmlns:models="clr-namespace:CentralBillingService.WPF.Models"
             Background="{StaticResource ContentBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="HasValue" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin"     Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CancelCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" />
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Rectificar Factura" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <TextBlock Foreground="#64748B" FontSize="12">
                        <Run Text="Factura original: " />
                        <Run Text="{Binding OriginalInvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-column body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Rectification params -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Background="White"
                          BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <StackPanel Margin="20">

                    <!-- Success banner -->
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="16,12" Margin="0,0,0,14"
                            Visibility="{Binding Success, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#10B981"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Factura rectificada correctamente." Foreground="#065F46"
                                       FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Error banner -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="16,12" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource HasValue}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Rectification data card -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,14" UniformCornerRadius="10"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="DATOS DE RECTIFICACIÓN" Style="{StaticResource SectionHeader}" />
                            <UniformGrid Columns="2">
                                <ComboBox Margin="0,0,6,12"
                                          materialDesign:HintAssist.Hint="Serie rectificativa *"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          IsEditable="True"
                                          Text="{Binding RectificativeSerie}"
                                          ItemsSource="{Binding AvailableSeries}"
                                          DisplayMemberPath="Code" />
                                <DatePicker Margin="6,0,0,12"
                                            materialDesign:HintAssist.Hint="Fecha emisión *"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding IssueDate}" />
                            </UniformGrid>
                            <ComboBox Margin="0,0,0,12"
                                      materialDesign:HintAssist.Hint="Tipo de rectificación *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{x:Static vm:RectifyInvoiceViewModel.RectificationTypes}"
                                      SelectedItem="{Binding SelectedRectificationType}" />
                            <TextBox Margin="0,0,0,12"
                                     materialDesign:HintAssist.Hint="Motivo (mínimo 10 caracteres) *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding Reason}"
                                     AcceptsReturn="True" MinLines="2" />
                            <UniformGrid Columns="2">
                                <TextBox Margin="0,0,6,12"
                                         materialDesign:HintAssist.Hint="Referencia de pago *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding PaymentReference}" />
                                <TextBox Margin="6,0,0,12"
                                         materialDesign:HintAssist.Hint="Método de pago"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding PaymentMethod}" />
                            </UniformGrid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Notas"
                                           FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Cargar plantilla:"
                                               FontSize="11" Foreground="#64748B"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding AvailableNotes}"
                                              DisplayMemberPath="Name"
                                              materialDesign:HintAssist.Hint="Seleccionar…"
                                              Width="200" Padding="8,4"
                                              SelectedItem="{Binding SelectedNoteTemplate, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBox materialDesign:HintAssist.Hint="Notas"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding Notes}"
                                     AcceptsReturn="True" MinLines="2" />
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Original invoice reference + Difference lines -->
            <DockPanel Grid.Column="1">
                <!-- Right panel header bar -->
                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <TextBlock Text="FACTURA ORIGINAL — REFERENCIA"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center" Margin="0" />
                        <ProgressBar HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="16" Height="16"
                                     Visibility="{Binding IsLoadingOriginal, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Scrollable content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">

                        <!-- Original invoice totals summary -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16,10"
                                Margin="0,0,0,12"
                                Visibility="{Binding OriginalInvoice, Converter={StaticResource HasValue}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fecha" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding OriginalInvoice.IssueDate, StringFormat=dd/MM/yyyy}"
                                               FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Base imponible" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding OriginalInvoice.TaxableBaseEur.Formatted}"
                                               FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="IVA" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding OriginalInvoice.TotalTaxAmountEur.Formatted}"
                                               FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="TOTAL EUR" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding OriginalInvoice.TotalEur.Formatted}"
                                               FontWeight="Bold" FontSize="15" Foreground="#1E293B" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="TOTAL CLIENTE" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding OriginalInvoice.TotalInOriginCurrency.Formatted}"
                                               FontWeight="Bold" FontSize="15" Foreground="#6366F1" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Original lines column headers -->
                        <Grid Margin="0,0,0,6"
                              Visibility="{Binding OriginalInvoice, Converter={StaticResource HasValue}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Descripción" FontSize="11"
                                       Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="Cant." FontSize="11"
                                       Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Precio unit." FontSize="11"
                                       Foreground="#94A3B8" HorizontalAlignment="Right"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="IVA" FontSize="11"
                                       Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Original invoice lines -->
                        <ItemsControl ItemsSource="{Binding OriginalInvoice.Lines}"
                                      Visibility="{Binding OriginalInvoice, Converter={StaticResource HasValue}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding UnitPriceOrigin.Formatted}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TaxRatePercentage, StringFormat={}{0}%}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.CopyOriginalLineCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsDifference,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Copiar como línea de diferencia (cantidad negada)">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ArrowDownBold"
                                                                             Width="14" Height="14"
                                                                             Margin="0,0,4,0" />
                                                    <TextBlock Text="Rectificar" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Difference lines section (only when Difference mode) -->
                        <Border Background="#F0F9FF" CornerRadius="8" Padding="16"
                                Margin="0,20,0,0"
                                Visibility="{Binding IsDifference, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="LÍNEAS DE DIFERENCIA"
                                               Style="{StaticResource SectionHeader}"
                                               VerticalAlignment="Center" Margin="0" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding AddLineCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" />
                                            <TextBlock Text="Añadir línea" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DifferenceLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:InvoiceLineItem}">
                                            <Border BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="36" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0" Margin="0,0,8,0"
                                                                  materialDesign:HintAssist.Hint="Descripción / Producto *"
                                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                  IsEditable="True"
                                                                  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedItem="{Binding SelectedProduct}"
                                                                  ItemsSource="{Binding DataContext.AvailableProducts,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="Description" />
                                                        <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                                                  materialDesign:HintAssist.Hint="Moneda"
                                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                  IsEditable="True"
                                                                  Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{x:Static models:InvoiceLineItem.CurrencyCodes}" />
                                                        <TextBox Grid.Column="2" Margin="0,0,8,0"
                                                                 materialDesign:HintAssist.Hint="Cant."
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 Text="{Binding Quantity}" />
                                                        <TextBox Grid.Column="3" Margin="0,0,8,0"
                                                                 materialDesign:HintAssist.Hint="Precio unit."
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 Text="{Binding UnitPrice}" />
                                                        <ComboBox Grid.Column="4" Margin="0,0,8,0"
                                                                  materialDesign:HintAssist.Hint="IVA %"
                                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                  ItemsSource="{x:Static models:InvoiceLineItem.TaxRates}"
                                                                  SelectedItem="{Binding TaxRate}" />
                                                        <Button Grid.Column="5"
                                                                Style="{StaticResource MaterialDesignIconButton}"
                                                                Foreground="#EF4444"
                                                                Command="{Binding DataContext.RemoveLineCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="TrashCanOutline" />
                                                        </Button>
                                                    </Grid>
                                                    <!-- Exchange rate hint (shown when non-EUR currency selected) -->
                                                    <TextBlock Text="{Binding ExchangeRateHint}"
                                                               Visibility="{Binding ExchangeRateHint,
                                                                   Converter={StaticResource HasValue}}"
                                                               FontSize="10" Foreground="#6366F1"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Footer: totals (difference mode only) + actions -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live totals — only shown for Difference type (raw sums, actual EUR amounts computed at issue time) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsDifference, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="BASE (est.)" FontSize="10" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalsSubtotalFormatted}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="IVA (est.)" FontSize="10" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalsTaxFormatted}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOTAL (est.)" FontSize="10" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalsTotalFormatted}"
                                   FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvBoolToVis}}"
                            Margin="0,0,12,0">
                        Cancelar
                    </Button>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvBoolToVis}}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            MinWidth="160">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Emitir Rectificativa" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
