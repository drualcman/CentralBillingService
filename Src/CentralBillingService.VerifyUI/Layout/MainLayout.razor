@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4">
            <span class="text-muted small">Portal de verificación de facturas</span>
        </div>
        <article class="content px-4">
            @Body
        </article>
        <footer class="border-top mt-4 py-3 px-4 text-muted" style="font-size: .78rem;">
            <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-between align-items-center">
                <span>&copy; @DateTime.Now.Year Sergi Ortiz Gómez</span>
                <div class="d-flex flex-wrap gap-3">
                    <a href="privacy-policy" class="text-muted text-decoration-none">Privacidad</a>
                    <a href="terms-of-use" class="text-muted text-decoration-none">Términos de uso</a>
                    <a href="https://legal.sergiortizgomez.com" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none">Aviso legal</a>
                </div>
            </div>
        </footer>
    </main>
</div>
