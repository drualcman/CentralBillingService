@page "/invoices/{invoiceNumber}/preview"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container-fluid px-0">

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading invoice…</span>
            </div>
            <p class="mt-3 text-muted">Loading invoice <strong>@InvoiceNumber</strong>…</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">
            <strong>Could not load invoice.</strong> @_error
            <div class="mt-2">
                <a href="" class="btn btn-sm btn-outline-danger"> ← Back</a>
            </div>
        </div>
    }
    else if (_model is not null)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-white sticky-top">
            <a href="" class="btn btn-sm btn-outline-secondary"> ← Back</a>
            <span class="text-muted small font-monospace">@InvoiceNumber</span>
            <button class="btn btn-outline-secondary w-50" @onclick="SendPdfAsync" disabled="@_sending">
                @if (_sending)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Send PDF by email
            </button>
        </div>

        @if (_sendMessage is not null)
        {
            <div class="alert @_sendAlertClass alert-dismissible m-3" role="alert">
                @_sendMessage
                <button type="button" class="btn-close" @onclick="@(() => _sendMessage = null)" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex justify-content-center py-3" style="background: #e9ecef;">
            <ReportView ReportModel="@_model" ShowPreview="true" />
        </div>
    }

</div>

@code {
    [Parameter]
    public string InvoiceNumber { get; set; } = "";

    [SupplyParameterFromQuery(Name = "billingsource")]
    public string? BillingSource { get; set; }

    private ReportViewModel? _model;
    private bool _loading = true;
    private string? _error;

    private bool _sending;
    private string? _sendMessage;
    private string _sendAlertClass = "alert-success";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _model = null;

        try
        {
            var url = $"invoices/{Uri.EscapeDataString(InvoiceNumber)}/report"
                + (string.IsNullOrWhiteSpace(BillingSource) ? "" : $"?billingsource={Uri.EscapeDataString(BillingSource)}");

            _model = await Http.GetFromJsonAsync<ReportViewModel>(url);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _error = $"Invoice '{InvoiceNumber}' was not found.";
        }
        catch (HttpRequestException ex)
        {
            _error = $"The service is unavailable. ({ex.StatusCode})";
        }
        catch (Exception)
        {
            _error = "An unexpected error occurred while loading the invoice.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendPdfAsync()
    {
        _sending = true;
        _sendMessage = null;

        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                $"invoices/{Uri.EscapeDataString(InvoiceNumber)}/send-pdf");
            if (!string.IsNullOrWhiteSpace(BillingSource))
                request.Headers.Add("x-cbs-billing-source", BillingSource);

            var response = await Http.SendAsync(request);
            var result = await response.Content.ReadFromJsonAsync<SendPdfResult>();

            if (result?.Success is true)
            {
                _sendAlertClass = "alert-success";
                _sendMessage = result.Message;
            }
            else
            {
                _sendAlertClass = "alert-warning";
                _sendMessage = result?.Message ?? "Could not send the invoice.";
            }
        }
        catch (Exception)
        {
            _sendAlertClass = "alert-danger";
            _sendMessage = "An error occurred while contacting the service.";
        }
        finally
        {
            _sending = false;
        }
    }

    private record SendPdfResult(bool Success, string Message);
}
