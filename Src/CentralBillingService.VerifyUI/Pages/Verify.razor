@page "/"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        @if (_invoiceNumber is null || _hash is null)
        {
            <div class="card shadow border-0 overflow-hidden mt-4">
                <div class="p-4 text-center" style="background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);">
                    <div style="font-size: 3.5rem; line-height: 1;">⚠️</div>
                    <h5 class="fw-bold mt-3 mb-1 text-warning-emphasis">Invalid QR code</h5>
                    <p class="text-muted mb-0">
                        This URL does not contain the required invoice data.<br />
                        If you have a physical invoice, enter the details below to verify it manually.
                    </p>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label small text-muted">Invoice number</label>
                            <input class="form-control font-monospace" @bind="_fInvoiceNumber" placeholder="e.g. FOTO2026-0001" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small text-muted">Company code</label>
                            <input class="form-control font-monospace" @bind="_fBillingSource" placeholder="e.g. web-fotos" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted">Document hash</label>
                            <input class="form-control font-monospace" @bind="_fHash"
                                   placeholder="SHA-256 fingerprint printed on the invoice" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small text-muted">Your NIF</label>
                            <input class="form-control font-monospace" @bind="_fRecipientTaxId" placeholder="e.g. 12345678A" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small text-muted">Issue date</label>
                            <input class="form-control" type="date" @bind="_fIssueDate" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small text-muted">Total amount (€)</label>
                            <input class="form-control" type="number" step="0.01" min="0" @bind="_fAmount" placeholder="0.00" />
                        </div>
                        <div class="col-12 pt-1">
                            <button class="btn btn-primary w-100"
                                    @onclick="HandleManualVerify"
                                    disabled="@(string.IsNullOrWhiteSpace(_fInvoiceNumber) || string.IsNullOrWhiteSpace(_fHash) || string.IsNullOrWhiteSpace(_fBillingSource))">
                                Verify invoice
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Verifying…</span>
                </div>
                <p class="mt-3 text-muted">Verifying invoice <strong>@_invoiceNumber</strong>…</p>
            </div>
        }
        else if (_error is not null)
        {
            <div class="card shadow border-0 overflow-hidden">

                <div class="p-4 text-center text-white bg-danger">
                    <div style="font-size: 3rem; line-height: 1;">
                        ✗
                    </div>
                    <h5 class="fw-bold mt-2 mb-0">
                        Verification failed
                    </h5>
                    <p class="mb-0 mt-1 small" style="opacity: .8;">@_error</p>
                </div>

                <div class="card-body p-4">

                    <div class="row g-3 mb-4">

                        @if (!string.IsNullOrWhiteSpace(_invoiceNumber))
                        {
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <div class="small text-muted mb-1">Invoice number</div>
                                    <div class="fw-semibold font-monospace">@_invoiceNumber</div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_issueDate))
                        {
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <div class="small text-muted mb-1">Issue date</div>
                                    <div class="fw-semibold">@_issueDate</div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_amount))
                        {
                            <div class="col-12">
                                <div class="p-3 rounded-3 bg-light d-flex align-items-center justify-content-between">
                                    <div class="small text-muted">Total amount</div>
                                    <div class="fw-bold fs-5">@_amount €</div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="border-top pt-3">
                        <div class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing: .06em;">
                            Security checks
                        </div>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value=false />
                                <span class="small">Document authenticity</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value=false />
                                <span class="small">Record integrity</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value=false />
                                <span class="small">QR data consistent</span>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button class="btn btn-outline-secondary" @onclick="Retry">Retry</button>
                    </div>
                </div>
            </div>
        }
        else if (_result is not null)
        {
            <div class="card shadow border-0 overflow-hidden">

                <div class="p-4 text-center text-white @(_result.IsValid ? "bg-success" : "bg-danger")">
                    <div style="font-size: 3rem; line-height: 1;">
                        @(_result.IsValid ? "✓" : "✗")
                    </div>
                    <h5 class="fw-bold mt-2 mb-0">
                        @(_result.IsValid ? "Invoice verified" : "Verification failed")
                    </h5>
                    @if (_result.Message is not null)
                    {
                        <p class="mb-0 mt-1 small" style="opacity: .8;">@_result.Message</p>
                    }
                </div>

                <div class="card-body p-4">

                    <div class="row g-3 mb-4">

                        @if (_result.IssuerName is not null)
                        {
                            <div class="col-12">
                                <div class="p-3 rounded-3 bg-light">
                                    <div class="small text-muted mb-1">Issuer</div>
                                    <div class="fw-semibold">@_result.IssuerName</div>
                                    @if (_result.IssuerTaxId is not null)
                                    {
                                        <div class="small text-muted font-monospace mt-1">@_result.IssuerTaxId</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_result.RecipientName is not null)
                        {
                            <div class="col-12">
                                <div class="p-3 rounded-3 bg-light">
                                    <div class="small text-muted mb-1">Recipient</div>
                                    <div class="fw-semibold">@_result.RecipientName</div>
                                    @if (_result.RecipientTaxId is not null)
                                    {
                                        <div class="small text-muted font-monospace mt-1">@_result.RecipientTaxId</div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light h-100">
                                <div class="small text-muted mb-1">Invoice number</div>
                                <div class="fw-semibold font-monospace">@_result.InvoiceNumber</div>
                            </div>
                        </div>

                        @if (_result.IssueDate is not null)
                        {
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <div class="small text-muted mb-1">Issue date</div>
                                    <div class="fw-semibold">@_result.IssueDate.Value.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        }

                        @if (_result.TotalEur is not null)
                        {
                            <div class="col-12">
                                <div class="p-3 rounded-3 bg-light d-flex align-items-center justify-content-between">
                                    <div class="small text-muted">Total amount</div>
                                    <div class="fw-bold fs-5">@_result.TotalEur.Value.ToString("N2") €</div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="border-top pt-3">
                        <div class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing: .06em;">
                            Security checks
                        </div>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value="@_result.DocumentHashMatches" />
                                <span class="small">Document authenticity</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value="@_result.IntegrityVerified" />
                                <span class="small">Record integrity</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <StatusBadge Value="@_result.QrDataConsistent" />
                                <span class="small">QR data consistent</span>
                            </div>
                        </div>
                    </div>

                    @if (_sendMessage is not null)
                    {
                        <div class="alert @_sendAlertClass alert-dismissible mt-3" role="alert">
                            @_sendMessage
                            <button type="button" class="btn-close" @onclick="@(() => _sendMessage = null)" aria-label="Close"></button>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a class="btn btn-outline-primary"
                           href="@GetPreviewUrl()">
                            View invoice
                        </a>
                        <button class="btn btn-outline-secondary" @onclick="SendPdfAsync" disabled="@_sending">
                            @if (_sending)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Send PDF by email
                        </button>
                    </div>

                </div>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "invoiceNumber")]
    private string? _invoiceNumber { get; set; }

    [SupplyParameterFromQuery(Name = "hash")]
    private string? _hash { get; set; }

    [SupplyParameterFromQuery(Name = "billingsource")]
    private string? BillingSource { get; set; }

    [SupplyParameterFromQuery(Name = "recipienttaxid")]
    private string? _recipientTaxId { get; set; }

    [SupplyParameterFromQuery(Name = "issuedate")]
    private string? _issueDate { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    private string? _amount { get; set; }

    private VerifyInvoiceResponse? _result;
    private bool _loading;
    private string? _error;

    // Manual form state
    private string _fInvoiceNumber = "";
    private string _fHash = "";
    private string _fBillingSource = "";
    private string _fRecipientTaxId = "";
    private DateOnly? _fIssueDate;
    private decimal? _fAmount;

    private bool _sending;
    private string? _sendMessage;
    private string _sendAlertClass = "alert-success";

    protected override async Task OnInitializedAsync() => await VerifyAsync();

    private async Task VerifyAsync()
    {
        if (_invoiceNumber is null || _hash is null)
            return;

        _loading = true;
        _error = null;
        _result = null;

        try
        {
            var url = $"invoices/{Uri.EscapeDataString(_invoiceNumber)}/verify?hash={Uri.EscapeDataString(_hash)}&billingsource={Uri.EscapeDataString(BillingSource ?? string.Empty)}"
                + (_recipientTaxId is not null ? $"&recipienttaxid={Uri.EscapeDataString(_recipientTaxId)}" : "")
                + (_issueDate is not null ? $"&issuedate={Uri.EscapeDataString(_issueDate)}" : "")
                + (_amount is not null ? $"&amount={Uri.EscapeDataString(_amount)}" : "");

            _result = await Http.GetFromJsonAsync<VerifyInvoiceResponse>(url);
        }
        catch (HttpRequestException ex)
        {
            _error = $"The verification service is unavailable. ({ex.StatusCode})";
        }
        catch (Exception)
        {
            _error = "An unexpected error occurred while contacting the verification service.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendPdfAsync()
    {
        _sending = true;
        _sendMessage = null;

        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                $"invoices/{Uri.EscapeDataString(_invoiceNumber!)}/send-pdf");
            if (!string.IsNullOrWhiteSpace(BillingSource))
                request.Headers.Add("x-cbs-billing-source", BillingSource);

            var response = await Http.SendAsync(request);
            var result = await response.Content.ReadFromJsonAsync<SendPdfResult>();

            if (result?.Success is true)
            {
                _sendAlertClass = "alert-success";
                _sendMessage = result.Message;
            }
            else
            {
                _sendAlertClass = "alert-warning";
                _sendMessage = result?.Message ?? "Could not send the invoice.";
            }
        }
        catch (Exception)
        {
            _sendAlertClass = "alert-danger";
            _sendMessage = "An error occurred while contacting the service.";
        }
        finally
        {
            _sending = false;
        }
    }

    private record SendPdfResult(bool Success, string Message);

    private void HandleManualVerify()
    {
        var url = $"/?invoiceNumber={Uri.EscapeDataString(_fInvoiceNumber)}&hash={Uri.EscapeDataString(_fHash)}&billingsource={Uri.EscapeDataString(_fBillingSource)}"
            + (string.IsNullOrWhiteSpace(_fRecipientTaxId) ? "" : $"&recipienttaxid={Uri.EscapeDataString(_fRecipientTaxId)}")
            + (_fIssueDate.HasValue ? $"&issuedate={_fIssueDate.Value.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)}" : "")
            + (_fAmount.HasValue ? $"&amount={_fAmount.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}" : "");
        Nav.NavigateTo(url, forceLoad: true);
    }

    void Retry()
    {
        Nav.NavigateTo("", forceLoad: true);
    }

    string GetPreviewUrl()
    {
        var number = Uri.EscapeDataString(_result!.InvoiceNumber);
        var bs = Uri.EscapeDataString(BillingSource ?? string.Empty);
        return $"invoices/{number}/preview?billingsource={bs}";
    }
}
